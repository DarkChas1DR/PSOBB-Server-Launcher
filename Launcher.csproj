<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
  </PropertyGroup>

  <!-- Automatically copy the single-file published Launcher.exe to the live Launcher folder -->
  <Target Name="CopyPublishedExe" AfterTargets="Publish">
    <Copy SourceFiles="$(PublishDir)Launcher.exe" DestinationFolder="$(ProjectDir)..\..\Launcher" SkipUnchangedFiles="false" />
    <Message Importance="High" Text="--> Automatically copied published Launcher.exe to live Launcher folder!" />
  </Target>

</Project>
