<Window x:Class="Launcher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Launcher"
        mc:Ignorable="d"
        Title="Pioneer II - Server Launcher" Height="680" Width="980"
        Background="#121216" Foreground="#E0E0E0"
        WindowStartupLocation="CenterScreen" SnapsToDevicePixels="True"
        FontFamily="Segoe UI, Inter, Arial">

    <Window.Resources>
        <!-- Modern Dark Theme Color Palette -->
        <SolidColorBrush x:Key="BgDark" Color="#121216" />
        <SolidColorBrush x:Key="BgCard" Color="#1C1C24" />
        <SolidColorBrush x:Key="BgConsole" Color="#0B0B0E" />
        <SolidColorBrush x:Key="BorderBrush" Color="#2A2A38" />
        <SolidColorBrush x:Key="TextPrimary" Color="#FFFFFF" />
        <SolidColorBrush x:Key="TextSecondary" Color="#9A9AA6" />
        
        <!-- Accents -->
        <SolidColorBrush x:Key="AccentCyan" Color="#00D2FF" />
        <SolidColorBrush x:Key="AccentGreen" Color="#00FF88" />
        <SolidColorBrush x:Key="AccentRed" Color="#FF3366" />
        <SolidColorBrush x:Key="AccentOrange" Color="#FF9F43" />
        
        <LinearGradientBrush x:Key="GlowCyan" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#00D2FF" Offset="0"/>
            <GradientStop Color="#0072FF" Offset="1"/>
        </LinearGradientBrush>

        <!-- Custom ScrollBar Styling -->
        <Style x:Key="ModernScrollThumbs" TargetType="{x:Type Thumb}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Thumb}">
                        <Grid x:Name="Grid">
                            <Rectangle HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Width="Auto" Height="Auto" 
                                       Fill="#3E3E50" RadiusX="4" RadiusY="4" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="true">
                                <Setter TargetName="Grid" Property="Background" Value="#55556F" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Button Style -->
        <Style x:Key="ModernButton" TargetType="Button">
            <Setter Property="Background" Value="#2A2A38" />
            <Setter Property="Foreground" Value="#E0E0E0" />
            <Setter Property="BorderBrush" Value="#3A3A4A" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="15,8" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" CornerRadius="4" Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" 
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#38384A" />
                                <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource AccentCyan}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#1C1C24" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Background" Value="#1A1A22" />
                                <Setter TargetName="border" Property="BorderBrush" Value="#222" />
                                <Setter Property="Foreground" Value="#5E5E6E" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Start Button (Green Accent) -->
        <Style x:Key="StartButton" TargetType="Button" BasedOn="{StaticResource ModernButton}">
            <Setter Property="Background" Value="#1E3E2F" />
            <Setter Property="BorderBrush" Value="#28553F" />
            <Setter Property="Foreground" Value="#00FF88" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" CornerRadius="4" Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" 
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#254E3A" />
                                <Setter TargetName="border" Property="BorderBrush" Value="#32C07D" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#12251D" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Stop Button (Red Accent) -->
        <Style x:Key="StopButton" TargetType="Button" BasedOn="{StaticResource ModernButton}">
            <Setter Property="Background" Value="#3E1E25" />
            <Setter Property="BorderBrush" Value="#552832" />
            <Setter Property="Foreground" Value="#FF4D6A" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" CornerRadius="4" Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" 
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#4E252E" />
                                <Setter TargetName="border" Property="BorderBrush" Value="#C0324E" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#251216" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Flat Tab Control Template -->
        <Style TargetType="TabItem">
            <Setter Property="HeaderTemplate">
                <Setter.Value>
                    <DataTemplate>
                        <ContentPresenter Content="{Binding}" Margin="12,6" />
                    </DataTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="Border" BorderThickness="0,0,0,3" BorderBrush="Transparent" Margin="0,0,10,0" Padding="10,6">
                            <ContentPresenter x:Name="ContentSite" ContentSource="Header" RecognizesAccessKey="True" 
                                              HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Border" Property="BorderBrush" Value="{StaticResource AccentCyan}" />
                                <Setter Property="Foreground" Value="#00D2FF" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="False">
                                <Setter Property="Foreground" Value="#8A8A9A" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="#FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <!-- Header Row -->
            <RowDefinition Height="Auto" />
            <!-- Main Tabs Content -->
            <RowDefinition Height="*" />
            <!-- Status Footer -->
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- HEADER SECTION -->
        <Grid Grid.Row="0" Margin="0,0,0,15">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Title -->
            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                <TextBlock Text="PIONEER II" FontSize="11" FontWeight="Bold" Foreground="{StaticResource AccentCyan}" />
                <TextBlock Text="SERVER DASHBOARD" FontSize="24" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" />
            </StackPanel>

            <!-- Global Action Buttons -->
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button x:Name="BtnBackupNow" Content="CREATE BACKUP" Style="{StaticResource ModernButton}" Margin="0,0,10,0" Click="BtnBackupNow_Click" />
                <Button x:Name="BtnStartAll" Content="START ALL" Style="{StaticResource StartButton}" Margin="0,0,10,0" Click="BtnStartAll_Click" />
                <Button x:Name="BtnStopAll" Content="STOP ALL" Style="{StaticResource StopButton}" Click="BtnStopAll_Click" />
            </StackPanel>
        </Grid>

        <!-- MAIN TAB SECTION -->
        <TabControl Grid.Row="1" Background="Transparent" BorderThickness="0" Margin="0,5">
            <!-- DASHBOARD TAB -->
            <TabItem Header="DASHBOARD">
                <Grid Margin="0,15,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- NEWSERV CARD -->
                    <Border x:Name="BorderNewserv" Grid.Column="0" Background="{StaticResource BgCard}" BorderBrush="{StaticResource BorderBrush}" 
                            BorderThickness="1" CornerRadius="8" Margin="0,0,10,0" Padding="20">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <!-- Header -->
                            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,15">
                                <Ellipse x:Name="IndicatorNewserv" Width="12" Height="12" Fill="{StaticResource AccentRed}" Margin="0,0,10,0" />
                                <TextBlock Text="newserv Server Emulator" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" />
                            </StackPanel>

                            <!-- Info / Stats -->
                            <StackPanel Grid.Row="1" VerticalAlignment="Top" Margin="0,10">
                                <Grid Margin="0,5">
                                    <TextBlock Text="Status:" Foreground="{StaticResource TextSecondary}" />
                                    <TextBlock x:Name="TxtNewservStatus" Text="Stopped" Foreground="{StaticResource AccentRed}" FontWeight="Bold" HorizontalAlignment="Right" />
                                </Grid>
                                <Grid Margin="0,5">
                                    <TextBlock Text="Working Dir:" Foreground="{StaticResource TextSecondary}" />
                                    <TextBlock x:Name="TxtNewservDir" Text="d:\...\PhantasyStarOnlineServer" ToolTip="{Binding Text, ElementName=TxtNewservDir}" Foreground="{StaticResource TextPrimary}" HorizontalAlignment="Right" MaxWidth="220" TextTrimming="CharacterEllipsis" />
                                </Grid>
                                <Grid Margin="0,5">
                                    <TextBlock Text="Auto-Restart:" Foreground="{StaticResource TextSecondary}" />
                                    <TextBlock Text="Enabled" Foreground="{StaticResource AccentCyan}" HorizontalAlignment="Right" />
                                </Grid>
                            </StackPanel>

                            <!-- Controls -->
                            <Grid Grid.Row="2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Button x:Name="BtnStartNewserv" Grid.Column="0" Content="Start" Style="{StaticResource StartButton}" Margin="0,0,5,0" Click="BtnStartNewserv_Click" />
                                <Button x:Name="BtnStopNewserv" Grid.Column="1" Content="Stop" Style="{StaticResource StopButton}" Margin="5,0,0,0" Click="BtnStopNewserv_Click" />
                            </Grid>
                        </Grid>
                    </Border>

                    <!-- PHP CRONS CARD -->
                    <Border x:Name="BorderCrons" Grid.Column="1" Background="{StaticResource BgCard}" BorderBrush="{StaticResource BorderBrush}" 
                            BorderThickness="1" CornerRadius="8" Margin="10,0,10,0" Padding="20">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <!-- Header -->
                            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,15">
                                <Ellipse x:Name="IndicatorCrons" Width="12" Height="12" Fill="{StaticResource AccentRed}" Margin="0,0,10,0" />
                                <TextBlock Text="PHP Cron Runner" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" />
                            </StackPanel>

                            <!-- Info / Stats -->
                            <StackPanel Grid.Row="1" VerticalAlignment="Top" Margin="0,10">
                                <Grid Margin="0,5">
                                    <TextBlock Text="Status:" Foreground="{StaticResource TextSecondary}" />
                                    <TextBlock x:Name="TxtCronsStatus" Text="Stopped" Foreground="{StaticResource AccentRed}" FontWeight="Bold" HorizontalAlignment="Right" />
                                </Grid>
                                <Grid Margin="0,5">
                                    <TextBlock Text="Interval:" Foreground="{StaticResource TextSecondary}" />
                                    <TextBlock x:Name="TxtCronInterval" Text="5 seconds" Foreground="{StaticResource TextPrimary}" HorizontalAlignment="Right" />
                                </Grid>
                                <Grid Margin="0,5">
                                    <TextBlock Text="Run Mode:" Foreground="{StaticResource TextSecondary}" />
                                    <TextBlock x:Name="TxtCronMode" Text="Direct C# (Background)" Foreground="{StaticResource AccentCyan}" HorizontalAlignment="Right" />
                                </Grid>
                            </StackPanel>

                            <!-- Controls -->
                            <Grid Grid.Row="2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Button x:Name="BtnStartCrons" Grid.Column="0" Content="Start" Style="{StaticResource StartButton}" Margin="0,0,5,0" Click="BtnStartCrons_Click" />
                                <Button x:Name="BtnStopCrons" Grid.Column="1" Content="Stop" Style="{StaticResource StopButton}" Margin="5,0,0,0" Click="BtnStopCrons_Click" />
                            </Grid>
                        </Grid>
                    </Border>

                    <!-- SERVER STATISTICS CARD -->
                    <Border x:Name="BorderStats" Grid.Column="2" Background="{StaticResource BgCard}" BorderBrush="{StaticResource BorderBrush}" 
                            BorderThickness="1" CornerRadius="8" Margin="10,0,0,0" Padding="20">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <!-- Header -->
                            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,15">
                                <Ellipse x:Name="IndicatorStats" Width="12" Height="12" Fill="{StaticResource AccentCyan}" Margin="0,0,10,0" />
                                <TextBlock Text="Server Statistics" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" />
                            </StackPanel>

                            <!-- Stats List -->
                            <StackPanel Grid.Row="1" VerticalAlignment="Top" Margin="0,10">
                                <Grid Margin="0,5">
                                    <TextBlock Text="Registered Accounts:" Foreground="{StaticResource TextSecondary}" />
                                    <TextBlock x:Name="TxtStatsAccounts" Text="0" Foreground="{StaticResource TextPrimary}" FontWeight="Bold" HorizontalAlignment="Right" />
                                </Grid>
                                <Grid Margin="0,5">
                                    <TextBlock Text="Total Characters:" Foreground="{StaticResource TextSecondary}" />
                                    <TextBlock x:Name="TxtStatsCharacters" Text="0" Foreground="{StaticResource TextPrimary}" FontWeight="Bold" HorizontalAlignment="Right" />
                                </Grid>
                                <Grid Margin="0,5">
                                    <TextBlock Text="Backup Archives:" Foreground="{StaticResource TextSecondary}" />
                                    <TextBlock x:Name="TxtStatsBackups" Text="0" Foreground="{StaticResource AccentOrange}" FontWeight="Bold" HorizontalAlignment="Right" />
                                </Grid>
                                <Grid Margin="0,5">
                                    <TextBlock Text="Database (SQLite) Size:" Foreground="{StaticResource TextSecondary}" />
                                    <TextBlock x:Name="TxtStatsDbSize" Text="0 KB" Foreground="{StaticResource TextPrimary}" HorizontalAlignment="Right" />
                                </Grid>
                            </StackPanel>

                            <!-- Controls -->
                            <Grid Grid.Row="2">
                                <Button x:Name="BtnRefreshStats" Content="Refresh Statistics" Style="{StaticResource ModernButton}" Click="BtnRefreshStats_Click" />
                            </Grid>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>

            <!-- NEWSERV LOGS TAB -->
            <TabItem Header="NEWSERV LOGS">
                <Grid Margin="0,10,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBox x:Name="TxtNewservLog" Grid.Row="0" Background="{StaticResource BgConsole}" Foreground="#CCCCCC" 
                             BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" 
                             FontFamily="Consolas, Courier New" FontSize="12.5" IsReadOnly="True" 
                             VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" 
                             AcceptsReturn="True" TextWrapping="Wrap" Padding="8" />

                    <!-- Command Terminal Bar -->
                    <Grid Grid.Row="1" Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="console>" Foreground="{StaticResource AccentCyan}" FontWeight="Bold" VerticalAlignment="Center" Margin="5,0,10,0" />
                        <TextBox x:Name="TxtNewservCommand" Grid.Column="1" Background="{StaticResource BgConsole}" Foreground="#FFFFFF" 
                                 BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Padding="6,4" 
                                 FontFamily="Consolas" KeyDown="TxtNewservCommand_KeyDown" />
                        <Button x:Name="BtnSendNewservCommand" Grid.Column="2" Content="Send" Style="{StaticResource ModernButton}" 
                                Margin="8,0,0,0" Padding="15,4" Click="BtnSendNewservCommand_Click" />
                    </Grid>

                    <!-- Log controls -->
                    <Grid Grid.Row="2" Margin="0,8,0,0">
                        <CheckBox x:Name="ChkNewservScroll" Content="Auto-scroll" IsChecked="True" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center" />
                        <Button x:Name="BtnClearNewservLog" Content="Clear Logs" Style="{StaticResource ModernButton}" HorizontalAlignment="Right" Click="BtnClearNewservLog_Click" Padding="10,5" />
                    </Grid>
                </Grid>
            </TabItem>

            <!-- CRON LOGS TAB -->
            <TabItem Header="CRON LOGS">
                <Grid Margin="0,10,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBox x:Name="TxtCronLog" Grid.Row="0" Background="{StaticResource BgConsole}" Foreground="#CCCCCC" 
                             BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" 
                             FontFamily="Consolas, Courier New" FontSize="12.5" IsReadOnly="True" 
                             VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" 
                             AcceptsReturn="True" TextWrapping="Wrap" Padding="8" />

                    <!-- Log controls -->
                    <Grid Grid.Row="1" Margin="0,8,0,0">
                        <CheckBox x:Name="ChkCronScroll" Content="Auto-scroll" IsChecked="True" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center" />
                        <Button x:Name="BtnClearCronLog" Content="Clear Logs" Style="{StaticResource ModernButton}" HorizontalAlignment="Right" Click="BtnClearCronLog_Click" Padding="10,5" />
                    </Grid>
                </Grid>
            </TabItem>

            <!-- BACKUPS TAB -->
            <TabItem Header="BACKUPS">
                <Grid Margin="0,15,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="220" />
                    </Grid.ColumnDefinitions>

                    <!-- Backup List -->
                    <Border Grid.Column="0" Background="{StaticResource BgCard}" BorderBrush="{StaticResource BorderBrush}" 
                            BorderThickness="1" CornerRadius="8" Padding="15" Margin="0,0,15,0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            
                            <TextBlock Grid.Row="0" Text="AVAILABLE BACKUP ARCHIVES" FontSize="12" FontWeight="Bold" Foreground="{StaticResource AccentCyan}" Margin="0,0,0,10" />
                            
                            <ListView x:Name="LstBackups" Grid.Row="1" Background="{StaticResource BgConsole}" Foreground="#CCCCCC" 
                                      BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" 
                                      FontFamily="Segoe UI" FontSize="13" Padding="5">
                                <ListView.View>
                                    <GridView>
                                        <GridViewColumn Header="Filename" DisplayMemberBinding="{Binding Filename}" Width="280" />
                                        <GridViewColumn Header="Date Created" DisplayMemberBinding="{Binding DateCreated}" Width="150" />
                                        <GridViewColumn Header="Size" DisplayMemberBinding="{Binding Size}" Width="100" />
                                    </GridView>
                                </ListView.View>
                                <ListView.ItemContainerStyle>
                                    <Style TargetType="ListViewItem">
                                        <Setter Property="Background" Value="Transparent" />
                                        <Setter Property="Foreground" Value="#CCCCCC" />
                                        <Setter Property="BorderThickness" Value="0,0,0,1" />
                                        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
                                        <Setter Property="Padding" Value="6" />
                                        <Style.Triggers>
                                            <Trigger Property="IsSelected" Value="true">
                                                <Setter Property="Background" Value="#2A2A38" />
                                                <Setter Property="Foreground" Value="#FFFFFF" />
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </ListView.ItemContainerStyle>
                            </ListView>
                        </Grid>
                    </Border>

                    <!-- Backup Action Buttons -->
                    <StackPanel Grid.Column="1" VerticalAlignment="Top">
                        <TextBlock Text="BACKUP ACTIONS" FontSize="12" FontWeight="Bold" Foreground="{StaticResource AccentCyan}" Margin="0,0,0,10" />
                        
                        <Button x:Name="BtnCreateBackupTab" Content="Create New Backup" Style="{StaticResource StartButton}" Padding="15,10" Margin="0,0,0,12" Click="BtnCreateBackupTab_Click" />
                        <Button x:Name="BtnRestoreBackup" Content="Restore Selected Backup" Style="{StaticResource ModernButton}" BorderBrush="{StaticResource AccentOrange}" Foreground="{StaticResource AccentOrange}" Padding="15,10" Margin="0,0,0,12" Click="BtnRestoreBackup_Click" />
                        <Button x:Name="BtnDeleteBackup" Content="Delete Selected Backup" Style="{StaticResource StopButton}" Padding="15,10" Margin="0,0,0,12" Click="BtnDeleteBackup_Click" />
                        <Button x:Name="BtnOpenBackupsFolder" Content="Open Backups Folder" Style="{StaticResource ModernButton}" Padding="15,10" Click="BtnOpenBackupsFolder_Click" />
                        
                        <TextBlock Text="Note: Restoring a backup will overwrite character data, system accounts, and database. Running services will be stopped during restoration." 
                                   Foreground="{StaticResource TextSecondary}" FontSize="11" TextWrapping="Wrap" Margin="0,20,0,0" LineHeight="15" />
                    </StackPanel>
                </Grid>
            </TabItem>

            <!-- CRON CONFIG TAB -->
            <TabItem Header="CRON CONFIG">
                <Grid Margin="0,15,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="280" />
                    </Grid.ColumnDefinitions>

                    <!-- Crons List -->
                    <Border Grid.Column="0" Background="{StaticResource BgCard}" BorderBrush="{StaticResource BorderBrush}" 
                            BorderThickness="1" CornerRadius="8" Padding="15" Margin="0,0,15,0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            
                            <TextBlock Grid.Row="0" Text="CONFIGURED CRON TASKS" FontSize="12" FontWeight="Bold" Foreground="{StaticResource AccentCyan}" Margin="0,0,0,10" />
                            
                            <ListView x:Name="LstCronTasks" Grid.Row="1" Background="{StaticResource BgConsole}" Foreground="#CCCCCC" 
                                      BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" 
                                      FontFamily="Segoe UI" FontSize="13" Padding="5" SelectionChanged="LstCronTasks_SelectionChanged">
                                <ListView.View>
                                    <GridView>
                                        <GridViewColumn Header="Act" Width="40">
                                            <GridViewColumn.CellTemplate>
                                                <DataTemplate>
                                                    <CheckBox IsChecked="{Binding Enabled}" Click="ChkCronEnabled_Click" HorizontalAlignment="Center" />
                                                </DataTemplate>
                                            </GridViewColumn.CellTemplate>
                                        </GridViewColumn>
                                        <GridViewColumn Header="Name" DisplayMemberBinding="{Binding Name}" Width="150" />
                                        <GridViewColumn Header="Script Path" DisplayMemberBinding="{Binding ScriptPath}" Width="250" />
                                        <GridViewColumn Header="Interval" DisplayMemberBinding="{Binding IntervalSeconds}" Width="70" />
                                    </GridView>
                                </ListView.View>
                                <ListView.ItemContainerStyle>
                                    <Style TargetType="ListViewItem">
                                        <Setter Property="Background" Value="Transparent" />
                                        <Setter Property="Foreground" Value="#CCCCCC" />
                                        <Setter Property="BorderThickness" Value="0,0,0,1" />
                                        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
                                        <Setter Property="Padding" Value="6" />
                                        <Style.Triggers>
                                            <Trigger Property="IsSelected" Value="true">
                                                <Setter Property="Background" Value="#2A2A38" />
                                                <Setter Property="Foreground" Value="#FFFFFF" />
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </ListView.ItemContainerStyle>
                            </ListView>
                        </Grid>
                    </Border>

                    <!-- Edit/Add Panel -->
                    <Border Grid.Column="1" Background="{StaticResource BgCard}" BorderBrush="{StaticResource BorderBrush}" 
                            BorderThickness="1" CornerRadius="8" Padding="15">
                        <StackPanel>
                            <TextBlock x:Name="TxtCronEditorTitle" Text="ADD / EDIT CRON TASK" FontSize="12" FontWeight="Bold" Foreground="{StaticResource AccentCyan}" Margin="0,0,0,15" />
                            
                            <Grid Margin="0,0,0,10">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Text="Task Name:" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,5" />
                                <TextBox x:Name="TxtCronName" Grid.Row="1" Background="#121216" Foreground="#FFF" BorderBrush="{StaticResource BorderBrush}" Padding="6,4" />
                            </Grid>

                            <Grid Margin="0,0,0,10">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Text="Script Path (rel to website):" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,5" />
                                <TextBox x:Name="TxtCronScriptPath" Grid.Row="1" Background="#121216" Foreground="#FFF" BorderBrush="{StaticResource BorderBrush}" Padding="6,4" ToolTip="Example: api/cron_boss_tracker.php" />
                            </Grid>

                            <Grid Margin="0,0,0,15">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Text="Interval (Seconds):" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,5" />
                                <TextBox x:Name="TxtCronIntervalSec" Grid.Row="1" Background="#121216" Foreground="#FFF" BorderBrush="{StaticResource BorderBrush}" Padding="6,4" Width="100" HorizontalAlignment="Left" />
                            </Grid>

                            <CheckBox x:Name="ChkCronTaskEnabled" Content="Task Enabled" Foreground="{StaticResource TextPrimary}" Margin="0,0,0,20" IsChecked="True" />

                            <Button x:Name="BtnSaveCronTask" Content="SAVE TASK" Style="{StaticResource StartButton}" Padding="15,8" Margin="0,0,0,10" Click="BtnSaveCronTask_Click" />
                            <Button x:Name="BtnDeleteCronTask" Content="DELETE TASK" Style="{StaticResource StopButton}" Padding="15,8" Margin="0,0,0,10" Click="BtnDeleteCronTask_Click" />
                            <Button x:Name="BtnCancelCronEdit" Content="CLEAR FIELDS" Style="{StaticResource ModernButton}" Padding="15,8" Margin="0,0,0,20" Click="BtnCancelCronEdit_Click" />
                            
                            <Button x:Name="BtnResetCronsDefault" Content="RESET TO PSOBB DEFAULTS" Style="{StaticResource ModernButton}" BorderBrush="{StaticResource AccentOrange}" Foreground="{StaticResource AccentOrange}" Padding="15,8" Click="BtnResetCronsDefault_Click" />
                        </StackPanel>
                    </Border>
                </Grid>
            </TabItem>

            <!-- QUEST MANAGER TAB -->
            <TabItem Header="QUEST MANAGER">
                <Grid Margin="0,15,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="260" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- Quest Categories list -->
                    <Border Grid.Column="0" Background="{StaticResource BgCard}" BorderBrush="{StaticResource BorderBrush}" 
                            BorderThickness="1" CornerRadius="8" Padding="15" Margin="0,0,15,0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            
                            <TextBlock Grid.Row="0" Text="QUEST CATEGORIES" FontSize="12" FontWeight="Bold" Foreground="{StaticResource AccentCyan}" Margin="0,0,0,10" />
                            
                            <ListBox x:Name="LstQuestCategories" Grid.Row="1" Background="{StaticResource BgConsole}" Foreground="#CCCCCC" 
                                     BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" 
                                     FontFamily="Segoe UI" FontSize="13" Padding="5" SelectionChanged="LstQuestCategories_SelectionChanged" />
                        </Grid>
                    </Border>

                    <!-- Quests in Category -->
                    <Grid Grid.Column="1">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="180" />
                        </Grid.RowDefinitions>

                        <!-- Quests List -->
                        <Border Grid.Row="0" Background="{StaticResource BgCard}" BorderBrush="{StaticResource BorderBrush}" 
                                BorderThickness="1" CornerRadius="8" Padding="15" Margin="0,0,0,15">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                
                                <TextBlock Grid.Row="0" x:Name="TxtQuestsHeader" Text="QUESTS IN SELECTED CATEGORY" FontSize="12" FontWeight="Bold" Foreground="{StaticResource AccentCyan}" Margin="0,0,0,10" />
                                
                                <ListView x:Name="LstQuests" Grid.Row="1" Background="{StaticResource BgConsole}" Foreground="#CCCCCC" 
                                          BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" 
                                          FontFamily="Segoe UI" FontSize="13" Padding="5" SelectionChanged="LstQuests_SelectionChanged">
                                    <ListView.View>
                                        <GridView>
                                            <GridViewColumn Header="Act" Width="40">
                                                <GridViewColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <CheckBox IsChecked="{Binding Enabled}" Click="ChkQuestEnabled_Click" HorizontalAlignment="Center" />
                                                    </DataTemplate>
                                                </GridViewColumn.CellTemplate>
                                            </GridViewColumn>
                                            <GridViewColumn Header="Quest ID" DisplayMemberBinding="{Binding BaseName}" Width="120" />
                                            <GridViewColumn Header="Type" DisplayMemberBinding="{Binding Extension}" Width="60" />
                                            <GridViewColumn Header="Has Config" DisplayMemberBinding="{Binding HasConfig}" Width="80" />
                                            <GridViewColumn Header="Last Modified" DisplayMemberBinding="{Binding LastModified}" Width="150" />
                                        </GridView>
                                    </ListView.View>
                                    <ListView.ItemContainerStyle>
                                        <Style TargetType="ListViewItem">
                                            <Setter Property="Background" Value="Transparent" />
                                            <Setter Property="Foreground" Value="#CCCCCC" />
                                            <Setter Property="BorderThickness" Value="0,0,0,1" />
                                            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
                                            <Setter Property="Padding" Value="6" />
                                            <Style.Triggers>
                                                <Trigger Property="IsSelected" Value="true">
                                                    <Setter Property="Background" Value="#2A2A38" />
                                                    <Setter Property="Foreground" Value="#FFFFFF" />
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ListView.ItemContainerStyle>
                                </ListView>
                            </Grid>
                        </Border>

                        <!-- Quest Details & Editing Panel -->
                        <Border Grid.Row="1" Background="{StaticResource BgCard}" BorderBrush="{StaticResource BorderBrush}" 
                                BorderThickness="1" CornerRadius="8" Padding="15">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="220" />
                                </Grid.ColumnDefinitions>
                                
                                <!-- Quest Config / AvailableIf editor -->
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="QUEST CONFIGURATION (METADATA)" FontSize="12" FontWeight="Bold" Foreground="{StaticResource AccentCyan}" Margin="0,0,0,10" />
                                    
                                    <Grid Margin="0,5">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="180" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Availability flag (AvailableIf):" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center" />
                                        <TextBox x:Name="TxtQuestAvailableIf" Grid.Column="1" Background="#121216" Foreground="#FFF" BorderBrush="{StaticResource BorderBrush}" Padding="6,4" Width="150" HorizontalAlignment="Left" ToolTip="Flag required to unlock this quest (e.g. F_01F5)" />
                                    </Grid>
                                    
                                    <Button x:Name="BtnSaveQuestConfig" Content="Save Quest Config" Style="{StaticResource StartButton}" Padding="15,6" Margin="0,10,0,0" Width="160" HorizontalAlignment="Left" Click="BtnSaveQuestConfig_Click" />
                                </StackPanel>

                                <!-- Quest Actions -->
                                <StackPanel Grid.Column="1" VerticalAlignment="Top" HorizontalAlignment="Right">
                                    <TextBlock Text="QUEST ACTIONS" FontSize="12" FontWeight="Bold" Foreground="{StaticResource AccentCyan}" Margin="0,0,0,10" />
                                    <Button x:Name="BtnUploadQuest" Content="Upload Custom Quest" Style="{StaticResource ModernButton}" Padding="15,6" Margin="0,0,0,10" Click="BtnUploadQuest_Click" />
                                    <Button x:Name="BtnOpenQuestsDir" Content="Open Quests Directory" Style="{StaticResource ModernButton}" Padding="15,6" Click="BtnOpenQuestsDir_Click" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>
            </TabItem>

            <!-- SERVER CONFIG TAB -->
            <TabItem Header="SERVER CONFIG">
                <ScrollViewer Margin="0,15,0,0" VerticalScrollBarVisibility="Auto">
                    <StackPanel MaxWidth="800" HorizontalAlignment="Left" Margin="10,0">
                        <!-- Server Identity -->
                        <TextBlock Text="SERVER IDENTITY" FontSize="12" FontWeight="Bold" Foreground="{StaticResource AccentCyan}" Margin="0,0,0,8" />
                        <Border Background="{StaticResource BgCard}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="15" Margin="0,0,0,20">
                            <StackPanel>
                                <Grid Margin="0,5">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <TextBlock Grid.Row="0" Text="Server Name:" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,5" />
                                    <TextBox x:Name="TxtCfgServerName" Grid.Row="1" Background="#121216" Foreground="#FFF" BorderBrush="{StaticResource BorderBrush}" Padding="6,4" />
                                </Grid>
                                <Grid Margin="0,10,0,5">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                        <TextBlock Text="Local IP Address:" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,5" />
                                        <TextBox x:Name="TxtCfgLocalAddress" Background="#121216" Foreground="#FFF" BorderBrush="{StaticResource BorderBrush}" Padding="6,4" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                        <TextBlock Text="External IP Address:" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,5" />
                                        <TextBox x:Name="TxtCfgExternalAddress" Background="#121216" Foreground="#FFF" BorderBrush="{StaticResource BorderBrush}" Padding="6,4" />
                                    </StackPanel>
                                </Grid>
                                <Grid Margin="0,10,0,5">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <TextBlock Grid.Row="0" Text="Lobby Welcome Message:" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,5" />
                                    <TextBox x:Name="TxtCfgWelcomeMessage" Grid.Row="1" Background="#121216" Foreground="#FFF" BorderBrush="{StaticResource BorderBrush}" Padding="6,4" AcceptsReturn="True" TextWrapping="Wrap" Height="100" VerticalScrollBarVisibility="Auto" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Boost Rates -->
                        <TextBlock Text="GAMEPLAY BOOST RATES (MULTIPLIERS)" FontSize="12" FontWeight="Bold" Foreground="{StaticResource AccentCyan}" Margin="0,0,0,8" />
                        <Border Background="{StaticResource BgCard}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="15" Margin="0,0,0,20">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                
                                <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,5,10,10">
                                    <TextBlock Text="Experience (EXP) Boost Multiplier:" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,5" />
                                    <TextBox x:Name="TxtCfgExpMultiplier" Background="#121216" Foreground="#FFF" BorderBrush="{StaticResource BorderBrush}" Padding="6,4" />
                                </StackPanel>
                                <StackPanel Grid.Row="0" Grid.Column="1" Margin="10,5,0,10">
                                    <TextBlock Text="Drop Rate (DAR) Boost Multiplier:" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,5" />
                                    <TextBox x:Name="TxtCfgDarMultiplier" Background="#121216" Foreground="#FFF" BorderBrush="{StaticResource BorderBrush}" Padding="6,4" />
                                </StackPanel>
                                <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,10,10,5">
                                    <TextBlock Text="Rare Drop (RDR) Boost Multiplier:" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,5" />
                                    <TextBox x:Name="TxtCfgRdrMultiplier" Background="#121216" Foreground="#FFF" BorderBrush="{StaticResource BorderBrush}" Padding="6,4" />
                                </StackPanel>
                                <StackPanel Grid.Row="1" Grid.Column="1" Margin="10,10,0,5">
                                    <TextBlock Text="Rare Monster Boost Multiplier:" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,5" />
                                    <TextBox x:Name="TxtCfgRareMonsterMultiplier" Background="#121216" Foreground="#FFF" BorderBrush="{StaticResource BorderBrush}" Padding="6,4" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Policies -->
                        <TextBlock Text="SERVER RULES &amp; POLICIES" FontSize="12" FontWeight="Bold" Foreground="{StaticResource AccentCyan}" Margin="0,0,0,8" />
                        <Border Background="{StaticResource BgCard}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="15" Margin="0,0,0,20">
                            <StackPanel>
                                <CheckBox x:Name="ChkCfgAllowUnregistered" Content="Allow unregistered players (Auto-create account on login)" Foreground="{StaticResource TextPrimary}" Margin="0,0,0,10" />
                                <CheckBox x:Name="ChkCfgAllowConcurrent" Content="Allow concurrent logins on the same account" Foreground="{StaticResource TextPrimary}" Margin="0,0,0,10" />
                                <CheckBox x:Name="ChkCfgChatCommands" Content="Enable server chat commands ($swa, $cheat, etc.)" Foreground="{StaticResource TextPrimary}" Margin="0,0,0,10" />
                                <CheckBox x:Name="ChkCfgBotSimulator" Content="Enable AI Bot Bounty Simulator (Auto accept/complete missions)" Foreground="{StaticResource TextPrimary}" Checked="ChkCfgBotSimulator_Checked" Unchecked="ChkCfgBotSimulator_Unchecked" />
                            </StackPanel>
                        </Border>

                        <!-- Lobby Event Scheduler -->
                        <TextBlock Text="LOBBY EVENT &amp; MENU THEME SCHEDULER" FontSize="12" FontWeight="Bold" Foreground="{StaticResource AccentCyan}" Margin="0,0,0,8" />
                        <Border Background="{StaticResource BgCard}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="15" Margin="0,0,0,20">
                            <StackPanel>
                                <Grid Margin="0,5">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="200" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                        <TextBlock Text="Lobby Holiday Event:" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,5" />
                                        <ComboBox x:Name="CboCfgLobbyEvent" Background="#121216" Foreground="#FFF" BorderBrush="{StaticResource BorderBrush}" Padding="6,4">
                                            <ComboBoxItem Content="none" />
                                            <ComboBoxItem Content="xmas" />
                                            <ComboBoxItem Content="val" />
                                            <ComboBoxItem Content="easter" />
                                            <ComboBoxItem Content="hallo" />
                                            <ComboBoxItem Content="sonic" />
                                            <ComboBoxItem Content="newyear" />
                                            <ComboBoxItem Content="bval" />
                                            <ComboBoxItem Content="wedding" />
                                            <ComboBoxItem Content="spring" />
                                            <ComboBoxItem Content="s-spring" />
                                            <ComboBoxItem Content="summer" />
                                            <ComboBoxItem Content="s-summer" />
                                            <ComboBoxItem Content="fall" />
                                        </ComboBox>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Bottom" Margin="20,0,0,0">
                                        <CheckBox x:Name="ChkCfgAutoLobbyEvent" Content="Automatically schedule events based on system calendar date" Foreground="{StaticResource TextPrimary}" Margin="0,0,0,10" Click="ChkCfgAutoLobbyEvent_Click" />
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Hourly Events & Global Boosters -->
                        <TextBlock Text="HOURLY EVENTS &amp; GLOBAL BOOSTERS" FontSize="12" FontWeight="Bold" Foreground="{StaticResource AccentCyan}" Margin="0,0,0,8" />
                        <Border Background="{StaticResource BgCard}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="15" Margin="0,0,0,20">
                            <StackPanel>
                                <Grid Margin="0,5">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                        <TextBlock Text="Global EXP Multiplier:" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,5" />
                                        <TextBox x:Name="TxtCfgGlobalExpMult" Background="#121216" Foreground="#FFF" BorderBrush="{StaticResource BorderBrush}" Padding="6,4" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Margin="5,0,5,0">
                                        <TextBlock Text="EXP Share Multiplier:" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,5" />
                                        <TextBox x:Name="TxtCfgExpShareMult" Background="#121216" Foreground="#FFF" BorderBrush="{StaticResource BorderBrush}" Padding="6,4" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Margin="10,0,0,0">
                                        <TextBlock Text="Global Drop Rate Mult:" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,5" />
                                        <TextBox x:Name="TxtCfgGlobalDropMult" Background="#121216" Foreground="#FFF" BorderBrush="{StaticResource BorderBrush}" Padding="6,4" />
                                    </StackPanel>
                                </Grid>

                                <Grid Margin="0,15,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    
                                    <!-- Happy Hour -->
                                    <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                        <CheckBox x:Name="ChkCfgHappyHourEnabled" Content="Enable Happy Hour" Foreground="{StaticResource TextPrimary}" Margin="0,0,0,10" />
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" Margin="0,0,5,0">
                                                <TextBlock Text="Min Drop Mult:" Foreground="{StaticResource TextSecondary}" FontSize="11" Margin="0,0,0,3" />
                                                <TextBox x:Name="TxtCfgHappyHourMin" Background="#121216" Foreground="#FFF" BorderBrush="{StaticResource BorderBrush}" Padding="4" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Margin="5,0,0,0">
                                                <TextBlock Text="Max Drop Mult:" Foreground="{StaticResource TextSecondary}" FontSize="11" Margin="0,0,0,3" />
                                                <TextBox x:Name="TxtCfgHappyHourMax" Background="#121216" Foreground="#FFF" BorderBrush="{StaticResource BorderBrush}" Padding="4" />
                                            </StackPanel>
                                        </Grid>
                                    </StackPanel>

                                    <!-- Party Hour -->
                                    <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                        <CheckBox x:Name="ChkCfgPartyHourEnabled" Content="Enable Party Hour" Foreground="{StaticResource TextPrimary}" Margin="0,0,0,10" />
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" Margin="0,0,5,0">
                                                <TextBlock Text="Min EXP Mult:" Foreground="{StaticResource TextSecondary}" FontSize="11" Margin="0,0,0,3" />
                                                <TextBox x:Name="TxtCfgPartyHourMin" Background="#121216" Foreground="#FFF" BorderBrush="{StaticResource BorderBrush}" Padding="4" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Margin="5,0,0,0">
                                                <TextBlock Text="Max EXP Mult:" Foreground="{StaticResource TextSecondary}" FontSize="11" Margin="0,0,0,3" />
                                                <TextBox x:Name="TxtCfgPartyHourMax" Background="#121216" Foreground="#FFF" BorderBrush="{StaticResource BorderBrush}" Padding="4" />
                                            </StackPanel>
                                        </Grid>
                                    </StackPanel>
                                </Grid>

                                <Grid Margin="0,15,0,5">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                        <TextBlock Text="Event Loop Interval (Seconds):" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,5" />
                                        <TextBox x:Name="TxtCfgEventInterval" Background="#121216" Foreground="#FFF" BorderBrush="{StaticResource BorderBrush}" Padding="6,4" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                        <TextBlock Text="Event Loop Duration (Seconds):" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,5" />
                                        <TextBox x:Name="TxtCfgEventDuration" Background="#121216" Foreground="#FFF" BorderBrush="{StaticResource BorderBrush}" Padding="6,4" />
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Buttons -->
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,30">
                            <Button x:Name="BtnSaveServerConfig" Content="SAVE SERVER CONFIG" Style="{StaticResource StartButton}" Padding="20,10" Click="BtnSaveServerConfig_Click" Width="200" Margin="0,0,10,0" />
                            <Button x:Name="BtnReloadServerConfig" Content="RELOAD FROM DISK" Style="{StaticResource ModernButton}" Padding="20,10" Click="BtnReloadServerConfig_Click" Width="200" />
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- SETTINGS TAB -->
            <TabItem Header="SETTINGS">
                <ScrollViewer Margin="0,15,0,0" VerticalScrollBarVisibility="Auto">
                    <StackPanel MaxWidth="800" HorizontalAlignment="Left">
                        <!-- Newserv Path Configuration -->
                        <TextBlock Text="NEWSERV CONFIGURATION" FontSize="12" FontWeight="Bold" Foreground="{StaticResource AccentCyan}" Margin="0,0,0,8" />
                        <Border Background="{StaticResource BgCard}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="15" Margin="0,0,0,20">
                            <StackPanel>
                                <Grid Margin="0,5">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <TextBlock Grid.Row="0" Text="newserv.exe Path:" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,5" />
                                    <Grid Grid.Row="1">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBox x:Name="TxtSetNewservPath" Grid.Column="0" Background="#121216" Foreground="#FFF" BorderBrush="{StaticResource BorderBrush}" Padding="6,4" />
                                        <Button x:Name="BtnBrowseNewserv" Grid.Column="1" Content="Browse" Style="{StaticResource ModernButton}" Margin="8,0,0,0" Click="BtnBrowseNewserv_Click" />
                                    </Grid>
                                </Grid>
                                <Grid Margin="0,10,0,5">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <TextBlock Grid.Row="0" Text="Working Directory:" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,5" />
                                    <Grid Grid.Row="1">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBox x:Name="TxtSetNewservDir" Grid.Column="0" Background="#121216" Foreground="#FFF" BorderBrush="{StaticResource BorderBrush}" Padding="6,4" />
                                        <Button x:Name="BtnBrowseNewservDir" Grid.Column="1" Content="Browse" Style="{StaticResource ModernButton}" Margin="8,0,0,0" Click="BtnBrowseNewservDir_Click" />
                                    </Grid>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- PHP / Website Path Configuration -->
                        <TextBlock Text="CRON / PHP CONFIGURATION" FontSize="12" FontWeight="Bold" Foreground="{StaticResource AccentCyan}" Margin="0,0,0,8" />
                        <Border Background="{StaticResource BgCard}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="15" Margin="0,0,0,20">
                            <StackPanel>
                                <Grid Margin="0,5">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <TextBlock Grid.Row="0" Text="php.exe Path:" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,5" />
                                    <Grid Grid.Row="1">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBox x:Name="TxtSetPhpPath" Grid.Column="0" Background="#121216" Foreground="#FFF" BorderBrush="{StaticResource BorderBrush}" Padding="6,4" />
                                        <Button x:Name="BtnBrowsePhp" Grid.Column="1" Content="Browse" Style="{StaticResource ModernButton}" Margin="8,0,0,0" Click="BtnBrowsePhp_Click" />
                                    </Grid>
                                </Grid>
                                <Grid Margin="0,10,0,5">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <TextBlock Grid.Row="0" Text="Website (www) Directory:" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,5" />
                                    <Grid Grid.Row="1">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBox x:Name="TxtSetWebsitePath" Grid.Column="0" Background="#121216" Foreground="#FFF" BorderBrush="{StaticResource BorderBrush}" Padding="6,4" />
                                        <Button x:Name="BtnBrowseWebsite" Grid.Column="1" Content="Browse" Style="{StaticResource ModernButton}" Margin="8,0,0,0" Click="BtnBrowseWebsite_Click" />
                                    </Grid>
                                </Grid>
                                <Grid Margin="0,10,0,5">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="200" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Cron Interval (Seconds):" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,5" />
                                        <TextBox x:Name="TxtSetCronInterval" Background="#121216" Foreground="#FFF" BorderBrush="{StaticResource BorderBrush}" Padding="6,4" Width="80" HorizontalAlignment="Left" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Bottom">
                                        <CheckBox x:Name="ChkRunDirectly" Content="Run PHP scripts directly in background (No CMD window)" Foreground="{StaticResource TextPrimary}" IsChecked="True" />
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Options Configuration -->
                        <TextBlock Text="LAUNCHER OPTIONS" FontSize="12" FontWeight="Bold" Foreground="{StaticResource AccentCyan}" Margin="0,0,0,8" />
                        <Border Background="{StaticResource BgCard}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="15" Margin="0,0,0,20">
                            <StackPanel>
                                <CheckBox x:Name="ChkAutoStart" Content="Automatically start servers on launcher startup" Foreground="{StaticResource TextPrimary}" Margin="0,0,0,10" />
                                <CheckBox x:Name="ChkMinimizeToTray" Content="Minimize to System Tray on close" Foreground="{StaticResource TextPrimary}" />
                            </StackPanel>
                        </Border>

                        <!-- Backup Configuration -->
                        <TextBlock Text="BACKUP CONFIGURATION" FontSize="12" FontWeight="Bold" Foreground="{StaticResource AccentCyan}" Margin="0,0,0,8" />
                        <Border Background="{StaticResource BgCard}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="15" Margin="0,0,0,20">
                            <StackPanel>
                                <CheckBox x:Name="ChkAutoBackupOnStart" Content="Auto-backup characters (.psochar) &amp; database on start" Foreground="{StaticResource TextPrimary}" Margin="0,0,0,10" />
                                <CheckBox x:Name="ChkAutoBackupOnStop" Content="Auto-backup characters (.psochar) &amp; database on stop" Foreground="{StaticResource TextPrimary}" Margin="0,0,0,10" />
                                <Grid Margin="0,5,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Max backups to keep:" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center" Margin="0,0,10,0" />
                                    <TextBox x:Name="TxtKeepMaxBackups" Grid.Column="1" Background="#121216" Foreground="#FFF" BorderBrush="{StaticResource BorderBrush}" Padding="6,4" Width="80" HorizontalAlignment="Left" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Save Button -->
                        <Button x:Name="BtnSaveSettings" Content="SAVE CONFIGURATION" Style="{StaticResource StartButton}" Padding="20,10" Click="BtnSaveSettings_Click" Width="220" HorizontalAlignment="Left" Margin="0,0,0,30" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <!-- FOOTER -->
        <Border Grid.Row="2" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="0,10,0,0" Margin="0,10,0,0">
            <Grid>
                <TextBlock Text="Pioneer II Server Management System © 2026" Foreground="{StaticResource TextSecondary}" FontSize="11" />
                <TextBlock x:Name="TxtTrayNotice" Text="Launcher is running in the background. Close window to minimize to tray." Foreground="{StaticResource TextSecondary}" FontSize="11" HorizontalAlignment="Right" Visibility="Collapsed" />
            </Grid>
        </Border>
    </Grid>
</Window>
